# Destino do proxy de /api/** (Django). Lido em tempo de execução (runtimeConfig privado).
NUXT_BACKEND_URL=http://127.0.0.1:8000

# Segredo compartilhado com o backend (cabeçalho X-Bela-Proxy-Secret). Só em produção; em desenvolvimento deixe vazio/ausente.
# NUNCA coloque este valor no código, no README ou em variáveis NUXT_PUBLIC_*.
NUXT_PROXY_SECRET=
